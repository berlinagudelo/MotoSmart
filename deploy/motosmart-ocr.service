[Unit]
Description=MotoSmart OCR worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=motosmart
Group=motosmart
WorkingDirectory=/opt/motosmart
EnvironmentFile=/etc/motosmart/motosmart.env
ExecStart=/opt/motosmart/.venv/bin/python -m flask --app app procesar-ocr
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/motosmart /var/log/motosmart
UMask=0077

[Install]
WantedBy=multi-user.target
