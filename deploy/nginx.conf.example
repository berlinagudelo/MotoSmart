# Ejemplo de Nginx delante de Gunicorn/Waitress.
# Ajusta el dominio y las rutas de certificados antes de usarlo.
server {
    listen 80;
    server_name motorsmart.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name motorsmart.example.com;

    ssl_certificate /etc/letsencrypt/live/motorsmart.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/motorsmart.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /static/ {
        alias /opt/motosmart/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
